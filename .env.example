# ─── PostgreSQL ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=pos_user
DB_PASSWORD=supersecret
DB_NAME=pos_db
DB_SCHEMA=public
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SYNC=false
DB_LOGGING=false

# ─── Redis ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=300
REDIS_KEY_PREFIX=pos:

# ─── JWT ─────────────────────────────────────────────
JWT_ACCESS_SECRET=secret_pos_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=secret_pos_refresh
JWT_REFRESH_EXPIRES_IN=7d

# ─── Rate Limiting ───────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ─── Bull / Queue ────────────────────────────────────
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379
BULL_REDIS_DB=1

# ─── SMS (devsms.uz) ─────────────────────────────────
DEVSMS_TOKEN=your_devsms_bearer_token
DEVSMS_FROM=4546
DEVSMS_BASE_URL=https://devsms.uz/api
DEVSMS_CALLBACK_URL=http://localhost:3000/sms/callback

# ─── Logging ─────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=./logs
