# ─── App ────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ─── Allowed Origins (CSV) ───────────────────────────
CASHIER_ORIGIN=https://cashier.url.com
DASHBOARD_ORIGIN=https://dashboard.url.com


# ─── DO SPACES ──────────────────────────────────────
DO_SPACES_ENDPOINT=https://salepoint.fra1.digitaloceanspaces.com
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=salepoint
DO_SPACES_KEY=dop_v1_364cb80da919aafbe11b7368835c7c82edb35ef96c21abbf965e1c2c7f844719
DO_SPACES_SECRET=+I1wLKQn/s570tadi+ej6jkT0CX+L4PhJaZOJX/2dWQ
